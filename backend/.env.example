NODE_ENV=development
PORT=4012
DATABASE_URL=postgresql://iptv_admin:CHANGE_ME@127.0.0.1:5432/iptv_front
JWT_SECRET=SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# HTTPS + reverse proxy used in production. HTTP cookie only on localhost dev.
COOKIE_SECURE=false
# Comma separated origins of trusted admin frontends; keep empty with same-origin deployment.
CORS_ORIGINS=http://localhost:4200
# Used for OIDC callback links.
PUBLIC_API_URL=http://localhost:4012/api/v1
# Always a fixed trusted frontend URL, never a query-provided redirect.
ADMIN_WEB_URL=http://localhost:4200
# Secrets of registered OIDC providers are stored in environment variables named by oauth_providers.secret_env_name.
# OIDC_SAMPLE_SECRET=...

# Log4js: log files always active; console output is optional
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_DIR=./logs
LOG_MAX_SIZE_MB=20
LOG_BACKUPS=10
LOG_COMPRESS=true
# Optional HTTP access logs, disabled by default for performance
LOG_HTTP_REQUESTS=false
