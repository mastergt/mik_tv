{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "iptv-admin-ui": {
      "projectType": "application",
      "schematics": { "@schematics/angular:component": { "style": "scss" } },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/iptv-admin-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": [{"glob":"**/*","input":"public","output":"/"}]
          },
          "configurations": {
            "production": {"optimization":{"scripts":true,"styles":true,"fonts":{"inline":false}},"budgets": [{"type":"initial","maximumWarning":"950kb","maximumError":"2mb"}],"outputHashing":"all"},
            "development": {"optimization":false,"sourceMap":true,"extractLicenses":false}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget":"iptv-admin-ui:build:production"},
            "development": {"buildTarget":"iptv-admin-ui:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {"analytics":false}
}
